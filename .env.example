CASPIAN_API_KEY=
CASPIAN_BASE_URL=https://api.trycaspianai.com
TELEGRAM_BOT_TOKEN=
EMAIL_USERNAME=pgops

# LLM Configuration (LiteLLM auto-detects provider keys like OPENROUTER_API_KEY, GROQ_API_KEY, OPENAI_API_KEY)
LLM_MODEL=openrouter/inclusionai/ling-3.0-flash:free
LLM_FALLBACK_MODEL=

# Provider API Keys (fill the one matching your LLM_MODEL prefix)
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional: custom proxy settings (e.g. for AgnesAI)
# LLM_MODEL=openai/agnes-2.5-flash
# LLM_API_KEY=
# LLM_BASE_URL=https://apihub.agnes-ai.com/v1

# Owner identity (telegram handle / email used to recognize the owner)
OWNER_TELEGRAM=
OWNER_EMAIL=

DB_PATH=data/pgops.db
